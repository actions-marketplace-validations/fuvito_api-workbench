# ---- Go ----

# Compiled binaries
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binaries
*.test

# Test artifacts and coverage
*.out
coverage.*
!coverage.go
*.coverprofile
profile.cov

# go.work.sum is generated — not committed
go.work.sum

# Vendor directory (not used; go workspace handles dependencies)
# vendor/

# ---- Frontend ----

node_modules/
dist/

# pnpm temp lock files (created during concurrent write protection)
pnpm-lock.yaml.*

# ---- Wails ----

# Embedded frontend build output (generated by pnpm build / wails build)
apps/desktop/wails/frontend/dist/

# Wails build output binary
apps/desktop/wails/build/bin/

# Generated TypeScript bindings (regenerated by wails build / wails dev)
apps/desktop/frontend/wailsjs/

# ---- Secrets and config ----

.env
.env.*
!.env.example

# ---- OS ----

.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
Desktop.ini

