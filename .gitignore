# ---- Go ----

# Compiled binaries
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binaries
*.test

# Test artifacts and coverage
*.out
coverage.*
!coverage.go
*.coverprofile
profile.cov

# go.work.sum is generated — not committed
go.work.sum

# Vendor directory (not used; go workspace handles dependencies)
# vendor/

# ---- Frontend ----

node_modules/
dist/

# pnpm temp lock files (created during concurrent write protection)
pnpm-lock.yaml.*

# npm lock file — project uses pnpm; prevent accidental npm install artifacts
package-lock.json

# ---- Testing ----

# Playwright generated reports and results
apps/desktop/e2e/playwright-report/
test-results/

# Frontend build integrity check (generated)
apps/desktop/frontend/package.json.md5

# ---- Wails ----

# Embedded frontend build output (generated by pnpm build / wails build)
apps/desktop/wails/frontend/dist/

# Wails build output binary
apps/desktop/wails/build/bin/

# Wails-generated TypeScript binding models (large, regenerated on build)
apps/desktop/frontend/wailsjs/go/models.ts
apps/desktop/frontend/wailsjs/runtime/

# ---- Secrets and config ----

.env
.env.*
!.env.example

# ---- OS ----

.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
Desktop.ini

# ---- Editor / IDE ----

.idea/
.vscode/
*.swp
*.swo
*~
